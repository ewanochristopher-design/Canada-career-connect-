# GEMINI_API_KEY: Optional AI key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign authentication session tokens.
SESSION_SECRET="change-me-to-a-strong-random-secret"

# STRIPE_SECRET_KEY: Optional Stripe secret key for live/test Checkout sessions.
STRIPE_SECRET_KEY=""

# MPESA_CONSUMER_KEY / SECRET / SHORTCODE / PASSKEY: Optional Safaricom Daraja credentials for live M-Pesa STK Push.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_ENV="sandbox"

# WHATSAPP_BUSINESS_NUMBER: Default WhatsApp Business contact number (digits only, international format).
WHATSAPP_BUSINESS_NUMBER="254700123456"

# VITE_GA_MEASUREMENT_ID: Optional Google Analytics 4 Measurement ID.
VITE_GA_MEASUREMENT_ID=""

# VITE_GSC_VERIFICATION: Optional Google Search Console verification token.
VITE_GSC_VERIFICATION=""
